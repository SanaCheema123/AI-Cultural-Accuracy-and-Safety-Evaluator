# CulturalGuard AI — local live-data configuration
APP_ENV=development
APP_NAME=CulturalGuard AI
API_V1_PREFIX=/api/v1

# Local development database. Docker Compose may override this with PostgreSQL.
DATABASE_URL=sqlite:///./culturalguard.db
UPLOAD_DIR=./uploads

# Development-only token signing secret. Replace before any shared/staging deployment.
JWT_SECRET=BDn2sIcx7-ELpW6JLyw4X8kWdn6_azrmLVdybFJ__fM
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_MINUTE=120

# -----------------------------------------------------------------------------
# FREE LIVE AI — GOOGLE GEMINI
# -----------------------------------------------------------------------------
# Create your own free-tier key in Google AI Studio:
# https://aistudio.google.com/apikey
#
# Never commit a real API key. The project does not contain or generate a shared key.
GEMINI_API_KEY=your_api_key_here

# Gemini 3.5 Flash-Lite supports text + image inputs and currently has an eligible
# free tier. You may change the model later if your Google AI Studio project offers
# another multimodal model.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_TIMEOUT_SECONDS=120
GEMINI_JSON_MODE=true

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
